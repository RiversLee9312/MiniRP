{
  "id": "stream-example",
  "packageName": "example.minichat.stream",
  "name": "Stream assets example",
  "apiVersion": 2,
  "entry": "index.mjs",
  "permissions": ["db"],
  "actions": {
    "handlers": { "announce": "announce", "consume": "consume", "produce": "produce", "sample-url": "sampleUrl", "measure": "measure", "encode-about": "encodeAbout", "about-url": "aboutUrl", "sample-changed": "sampleChanged" },
    "events": ["ready", "sample-changed"],
    "subscriptions": {
      "minirp://actions/example.minichat.stream/events/ready": "minirp://actions/example.minichat.stream/hooks/consume",
      "minirp://actions/example.minichat.stream/events/sample-changed": "minirp://actions/example.minichat.stream/hooks/sample-changed"
    }
  },
  "hooks": {
    "plugin.command": "minirp://actions/example.minichat.stream/hooks/announce"
  },
  "assets": [
    { "id": "about", "type": "file", "path": "about.md", "mimeType": "text/markdown", "accessibility": "public" },
    { "id": "about-utf16", "type": "dynamic", "handler": "minirp://actions/example.minichat.stream/hooks/encode-about", "mimeType": "text/plain", "accessibility": "private" },
    {
      "id": "sample",
      "type": "dynamic",
      "mimeType": "application/octet-stream",
      "accessibility": "protected",
      "listenable": true,
      "changeEvent": "minirp://actions/example.minichat.stream/events/sample-changed",
      "handler": "minirp://actions/example.minichat.stream/hooks/produce"
    }
  ],
  "settings": [
    {
      "key": "stream-example", "type": "page", "title": "Stream assets example",
      "items": [{ "key": "about", "type": "markdown", "content": "about" }]
    }
  ],
  "skills": [{
    "name": "resources",
    "description": "Generate a sample Asset URL or count the bytes of a supplied resource.",
    "agents": ["chat", "env", "preset"],
    "tools": [
      {
        "name": "sample_url",
        "description": "Return the URL of the generated sample.",
        "handler": "minirp://actions/example.minichat.stream/hooks/sample-url",
        "parameters": { "type": "object" },
        "returnType": "asset-url"
      },
      {
        "name": "about_url",
        "description": "Return the URL of the about text encoded as UTF-16LE.",
        "handler": "minirp://actions/example.minichat.stream/hooks/about-url",
        "parameters": { "type": "object" },
        "returnType": "asset-url"
      },
      {
        "name": "measure",
        "description": "Count the bytes of a supplied Asset URL.",
        "handler": "minirp://actions/example.minichat.stream/hooks/measure",
        "parameters": { "type": "object", "properties": { "url": { "type": "string" } }, "required": ["url"] }
      }
    ]
  }]
}
