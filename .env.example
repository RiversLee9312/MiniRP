# 主模型。保留 DEEPSEEK_* 键名以兼容现有 .env，也可配置其他提供商。
DEEPSEEK_API_KEY=your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# openai / responses / anthropic / gemini / ollama
MINIRP_PROVIDER_PROTOCOL=openai
DEEPSEEK_THINKING=enabled
# DEEPSEEK_REASONING_EFFORT=max

# 模型预算；压缩先完整归档，再生成摘要。默认阈值为上下文预算的 60%。
# DEEPSEEK_CONTEXT_WINDOW=128000
# DEEPSEEK_MAX_OUTPUT_TOKENS=8192
# DEEPSEEK_COMPACT_AT=76800
# DEEPSEEK_COMPACT_AT_PERCENT=80
# DEEPSEEK_BACKGROUND_COMPACTION=enabled
# DEEPSEEK_BACKGROUND_COMPACT_AT_PERCENT=70

# 可独立选择搜索和抓取服务。
# MINIRP_SEARCH_PROVIDER=deepseek
# MINIRP_FETCH_PROVIDER=deepseek
# DeepSeek、Tavily 和 Exa 支持搜索和抓取。Brave Search 支持搜索。
# MINIRP_SEARCH_API_KEY=your-search-api-key
# MINIRP_TAVILY_API_KEY=your-tavily-api-key
# MINIRP_EXA_API_KEY=your-exa-api-key
# MINIRP_BRAVE_SEARCH_API_KEY=your-brave-search-api-key

# api / local / api_then_local
MINIRP_FETCH_BACKEND=api_then_local
# 缺省时自动选择 WebView2 或完整 Chromium。可设置首选项为 webview2、chromium、chrome、msedge 或 cef。
# MINIRP_BROWSER=chromium
