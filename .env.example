# DeepSeek API Key（在 https://platform.deepseek.com/api_keys 申请）
DEEPSEEK_API_KEY=sk-your-key-here

# 可选：默认值已在代码里设好
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_THINKING=enabled
# DEEPSEEK_REASONING_EFFORT=max
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 上下文 / 输出预算（默认对齐 DeepSeek-V4.1-Flash-1017：1M context、384K 输出）
# DEEPSEEK_CONTEXT_WINDOW=1000000
# DEEPSEEK_MAX_OUTPUT_TOKENS=384000
# 压缩触发阈值（默认 512K token）
# DEEPSEEK_COMPACT_AT=512000

# 测试用：关闭真实搜索/抓取
# MINICHAT_OFFLINE=1
# 输入异常时强制使用标准 input()（禁用 prompt_toolkit）
# MINICHAT_PLAIN=1

# 默认启动的设定（presets/<id>.json）；不填则用 world_state.json 里的 active_preset
# MINICHAT_PRESET=ufo-2026
# 自定义预设目录（默认 ./presets）
# MINICHAT_PRESET_DIR=./presets
# 对话存档目录（默认 ./conversations，按预设隔离）
# MINICHAT_CONVERSATION_DIR=./conversations
# 抓取后端：api、local、api_then_local（默认 API 失败后回退本地）
# MINICHAT_FETCH_BACKEND=api_then_local
# Playwright MCP 使用的浏览器：chrome（默认）、msedge、firefox、webkit
# MINICHAT_BROWSER=chrome
# 单次本地抓取的总时间预算（秒）
# MINICHAT_LOCAL_FETCH_TIMEOUT=180
