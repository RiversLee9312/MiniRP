<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <OptimizationPreference Condition="'$(Configuration)' == 'Release'">Size</OptimizationPreference>
    <NativeLib>Shared</NativeLib>
    <AssemblyName>libminirpcore</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux-bionic'))">
    <DefineConstants>$(DefineConstants);MINIRP_ANDROID_BIONIC</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MiniRP.Core.Tests" />
    <EmbeddedResource Include="PluginBootstrap.js" LogicalName="MiniRP.PluginBootstrap.js" />
    <EmbeddedResource Include="PluginWebCrypto.js" LogicalName="MiniRP.PluginWebCrypto.js" />
    <EmbeddedResource Include="PluginWebCryptoProvider.js" LogicalName="MiniRP.PluginWebCryptoProvider.js" />
    <EmbeddedResource Include="Vendor/web-streams-polyfill.js" LogicalName="MiniRP.WebStreams.js" />
    <EmbeddedResource Include="BasePlugin/manifest.json" LogicalName="MiniRP.BasePlugin.manifest.json" />
    <EmbeddedResource Include="BasePlugin/index.js" LogicalName="MiniRP.BasePlugin.index.js" />
    <EmbeddedResource Include="AgentSkillNames.json" LogicalName="MiniRP.AgentSkillNames.json" />
    <EmbeddedResource Include="AgentToolNames.json" LogicalName="MiniRP.AgentToolNames.json" />
    <EmbeddedResource Include="ToolCardLabels.json" LogicalName="MiniRP.ToolCardLabels.json" />
    <EmbeddedResource Include="../../docs/plugins/*.md" Exclude="../../docs/plugins/README.md" LogicalName="MiniRP.PluginDocs.plugins.%(Filename)" />
    <EmbeddedResource Include="../../docs/presets/*.md" Exclude="../../docs/presets/README.md" LogicalName="MiniRP.PluginDocs.presets.%(Filename)" />
    <EmbeddedResource Include="../../sdk/javascript/manifest.schema.json" LogicalName="MiniRP.PluginDocs.schema" />
    <EmbeddedResource Include="../../THIRD_PARTY_NOTICES.md" LogicalName="MiniRP.BasePlugin.notices.md" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="MiniRP.BasePlugin.license" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="ReverseMarkdown" Version="6.3.0" />
    <PackageReference Include="Scout.Text.Regex" Version="0.8.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.11" />
    <ProjectReference Include="../MiniRP.Protocol/MiniRP.Protocol.csproj" />
  </ItemGroup>
  <Import Project="../../eng/AndroidNativeAot.targets" Condition="$(RuntimeIdentifier.StartsWith('linux-bionic'))" />
</Project>
