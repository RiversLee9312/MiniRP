<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>minirp</AssemblyName>
    <Version>1.2.9</Version>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Terminal.Gui" Version="2.5.0" />
    <PackageReference Include="Terminal.Gui.Editor" Version="2.5.7" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
    <PackageReference Include="Microsoft.ClearScript.V8" Version="7.5.1.1" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" Version="7.5.1.1" Condition="'$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-x64'" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-arm64" Version="7.5.1.1" Condition="'$(RuntimeIdentifier)' == 'win-arm64'" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-x64" Version="7.5.1.1" Condition="'$(RuntimeIdentifier)' == 'linux-x64'" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-arm64" Version="7.5.1.1" Condition="'$(RuntimeIdentifier)' == 'linux-arm64'" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.osx-x64" Version="7.5.1.1" Condition="'$(RuntimeIdentifier)' == 'osx-x64'" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.osx-arm64" Version="7.5.1.1" Condition="'$(RuntimeIdentifier)' == 'osx-arm64'" />
    <ProjectReference Include="../MiniRP.Protocol/MiniRP.Protocol.csproj" />
    <Content Include="../../apps/android/app/src/main/assets/turndown.js" Link="browser/turndown.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../apps/android/app/src/main/assets/turndown-LICENSE.txt" Link="browser/turndown-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../apps/android/app/src/main/assets/browser.js" Link="browser/browser.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
